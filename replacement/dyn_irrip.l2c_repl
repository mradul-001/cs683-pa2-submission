#include "cache.h"
#include <iostream>
#include <cstdlib>

// Dynamic I-RRIP: set-dueling replacement with SPP prefetch awareness
#define maxRRPV 3
#define NUM_LEADER_SETS 32

#ifndef IRRIP_THRESHOLD
#define IRRIP_THRESHOLD 0.25
#endif

static uint32_t l2_rrpv[L2C_SET][L2C_WAY];
static uint8_t l2_is_instr[L2C_SET][L2C_WAY];
static uint8_t l2_is_pref[L2C_SET][L2C_WAY];

// leader set counters for set dueling
static uint64_t leader_instr_accesses = 0;
static uint64_t leader_instr_misses = 0;
static uint64_t leader_total_accesses = 0;
static uint64_t leader_total_misses = 0;

static uint64_t follower_irrip_cycles = 0;
static uint64_t follower_rrip_cycles = 0;
static uint64_t prefetch_fills = 0;
static uint64_t prefetch_hits = 0;

static double decision_threshold = IRRIP_THRESHOLD;

static inline bool is_leader_set(uint32_t set) {
    return ((set % (L2C_SET / NUM_LEADER_SETS)) == 0);
}

// compute metric from leader set stats
static inline bool is_irrip_mode() {
    uint64_t total = leader_total_accesses + leader_total_misses;
    if (total < 64) {
        return true; // default during warmup
    }
    double metric = (double)(leader_instr_accesses + leader_instr_misses) / (double)total;
    return (metric >= decision_threshold);
}

void CACHE::l2c_initialize_replacement()
{
    char* env_thresh = getenv("IRRIP_THRESH");
    if (env_thresh != NULL) {
        decision_threshold = atof(env_thresh);
    } else {
        decision_threshold = IRRIP_THRESHOLD;
    }

    std::cout << "L2C Dynamic I-RRIP initialized (Threshold: " << decision_threshold << ")" << std::endl;

    for (int i = 0; i < L2C_SET; i++) {
        for (int j = 0; j < L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            l2_is_instr[i][j] = 0;
            l2_is_pref[i][j] = 0;
        }
    }

    leader_instr_accesses = 0;
    leader_instr_misses = 0;
    leader_total_accesses = 0;
    leader_total_misses = 0;
    follower_irrip_cycles = 0;
    follower_rrip_cycles = 0;
    prefetch_fills = 0;
    prefetch_hits = 0;
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    for (int i = 0; i < L2C_WAY; i++) {
        if (!current_set[i].valid) {
            return i;
        }
    }

    bool use_irrip = !is_leader_set(set) && is_irrip_mode();

    while (1) {
        if (use_irrip) {
            // prioritize unreferenced prefetches, then data, then instruction
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && l2_is_pref[set][i] == 1) {
                    return i;
                }
            }
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && l2_is_instr[set][i] == 0) {
                    return i;
                }
            }
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV) {
                    return i;
                }
            }
        } else {
            // standard RRIP victim search
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && l2_is_pref[set][i] == 1) {
                    return i;
                }
            }
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV) {
                    return i;
                }
            }
        }

        // age all blocks
        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] < maxRRPV) {
                l2_rrpv[set][i]++;
            }
        }
    }

    assert(0);
    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    // leader sets run RRIP and track stats
    if (is_leader_set(set)) {
        leader_total_accesses++;
        if (isInstruction)
            leader_instr_accesses++;
        if (!hit) {
            leader_total_misses++;
            if (isInstruction)
                leader_instr_misses++;
        }
        // decay leader stats periodically
        if ((leader_total_accesses + leader_total_misses) >= 16384) {
            leader_total_accesses >>= 1;
            leader_total_misses >>= 1;
            leader_instr_accesses >>= 1;
            leader_instr_misses >>= 1;
        }
    } else {
        if (is_irrip_mode())
            follower_irrip_cycles++;
        else
            follower_rrip_cycles++;
    }

    bool active_irrip = !is_leader_set(set) && is_irrip_mode();

    if (hit) {
        // prefetch hit turns block into demand
        if (l2_is_pref[set][way]) {
            prefetch_hits++;
            l2_is_pref[set][way] = 0;
        }

        if (active_irrip) {
            if (isInstruction || l2_is_instr[set][way]) {
                l2_rrpv[set][way] = 0;
                l2_is_instr[set][way] = 1;
            } else {
                l2_rrpv[set][way] = 1;
            }
        } else {
            l2_rrpv[set][way] = 0;
            if (isInstruction)
                l2_is_instr[set][way] = 1;
        }
    } else {
        bool is_prefetch = (type == PREFETCH);
        if (is_prefetch) {
            // insert prefetches at maxRRPV so they don't pollute cache
            prefetch_fills++;
            l2_is_pref[set][way] = 1;
            l2_rrpv[set][way] = maxRRPV;
            l2_is_instr[set][way] = isInstruction;
        } else if (active_irrip) {
            l2_is_pref[set][way] = 0;
            if (isInstruction) {
                l2_rrpv[set][way] = 1;
                l2_is_instr[set][way] = 1;
            } else {
                l2_rrpv[set][way] = maxRRPV - 1;
                l2_is_instr[set][way] = 0;
            }
        } else {
            l2_is_pref[set][way] = 0;
            l2_rrpv[set][way] = maxRRPV - 1;
            l2_is_instr[set][way] = isInstruction;
        }
    }
}

void CACHE::l2c_replacement_final_stats()
{
    std::cout << "CPU " << cpu << " L2C Dynamic I-RRIP Final Stats:" << std::endl;
    std::cout << "  Threshold: " << decision_threshold << std::endl;
    std::cout << "  Leader Set Metric: " << (leader_total_accesses + leader_total_misses > 0 ? 
        (double)(leader_instr_accesses + leader_instr_misses) / (double)(leader_total_accesses + leader_total_misses) : 0.0) << std::endl;
    std::cout << "  Follower Sets in I-RRIP mode: " << follower_irrip_cycles << std::endl;
    std::cout << "  Follower Sets in RRIP mode: " << follower_rrip_cycles << std::endl;
    std::cout << "  Prefetch Fills in L2: " << prefetch_fills << std::endl;
    std::cout << "  Useful Prefetch Hits in L2: " << prefetch_hits << std::endl;
}
